# Copy this file to .env.local and paste your NEW (rotated) keys. Never commit .env.local.
FAL_KEY=your_fal_key_here
OPENAI_API_KEY=your_openai_key_here

# Optional overrides
OPENAI_MODEL=gpt-4.1
FAL_IMAGE_MODEL=blackforestlabs/flux-3/edit-image
FAL_VIDEO_MODEL=blackforestlabs/flux-3-max/image-to-video
